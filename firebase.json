{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "outputs",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.csv",
      "*.txt",
      "문맥-단어왕-독립형.html"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
