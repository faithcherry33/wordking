rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGoogleTeacherSelf(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isTeacher() {
      return signedIn() && myProfile().data.role == "teacher";
    }

    function isAnonymousStudent() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function myStudentSession() {
      return get(/databases/$(database)/documents/studentSessions/$(request.auth.uid));
    }

    function isStudentOf(teacherId) {
      return isAnonymousStudent()
        && myStudentSession().data.teacherId == teacherId;
    }

    match /users/{userId} {
      allow create: if isGoogleTeacherSelf(userId)
        && request.resource.data.role == "teacher";
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow update: if isGoogleTeacherSelf(userId)
        && resource.data.role == "teacher"
        && request.resource.data.role == "teacher";
      allow delete: if false;
    }

    match /teachers/{teacherId} {
      allow read: if signedIn() && request.auth.uid == teacherId;
      allow write: if false;

      match /students/{studentId} {
        allow read: if signedIn() && request.auth.uid == teacherId;
        allow create: if signedIn()
          && request.auth.uid == teacherId
          && isTeacher()
          && request.resource.data.teacherId == teacherId
          && request.resource.data.role == "student";
        allow update: if signedIn()
          && request.auth.uid == teacherId
          && isTeacher()
          && resource.data.teacherId == teacherId
          && request.resource.data.teacherId == teacherId;
        allow delete: if false;
      }

      match /rankingAttempts/{attemptId} {
        allow read: if signedIn() && (
          request.auth.uid == teacherId ||
          isStudentOf(teacherId)
        );
        allow create: if isStudentOf(teacherId)
          && request.resource.data.teacherId == teacherId
          && request.resource.data.studentUid == request.auth.uid
          && request.resource.data.studentId == myStudentSession().data.studentId
          && request.resource.data.challengeType in ["dictionary", "inference"]
          && request.resource.data.correct is int
          && request.resource.data.total == 20
          && request.resource.data.rate is int;
        allow update, delete: if false;
      }

      match /learningAttempts/{attemptId} {
        allow read: if signedIn() && (
          request.auth.uid == teacherId ||
          resource.data.studentUid == request.auth.uid
        );
        allow create: if isStudentOf(teacherId)
          && request.resource.data.teacherId == teacherId
          && request.resource.data.studentUid == request.auth.uid
          && request.resource.data.studentId == myStudentSession().data.studentId
          && request.resource.data.total is int
          && request.resource.data.total > 0
          && request.resource.data.total <= 20
          && request.resource.data.correct is int
          && request.resource.data.rate is int
          && request.resource.data.results is list
          && request.resource.data.results.size() == request.resource.data.total;
        allow update, delete: if false;
      }
    }

    // Temporary classroom mode.
    // Students are not Firebase Auth users yet. They log in by reading this
    // document and comparing a browser-generated password hash. Replace this
    // with Cloud Functions + Firebase Auth before long-term use.
    match /studentLogins/{studentId} {
      allow get: if true;
      allow list: if false;
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.role == "student";
      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == request.auth.uid;
      allow delete: if false;
    }

    match /studentSessions/{studentUid} {
      allow read: if signedIn() && (
        request.auth.uid == studentUid ||
        (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow create, update: if isAnonymousStudent()
        && request.auth.uid == studentUid
        && request.resource.data.role == "student"
        && request.resource.data.studentId is string
        && request.resource.data.teacherId ==
          get(/databases/$(database)/documents/studentLogins/$(request.resource.data.studentId)).data.teacherId
        && request.resource.data.displayName ==
          get(/databases/$(database)/documents/studentLogins/$(request.resource.data.studentId)).data.displayName;
      allow delete: if false;
    }
  }
}
